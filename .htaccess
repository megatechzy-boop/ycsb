# Clean URLs: /about-samiti -> about-samiti.php
Options -Indexes
ErrorDocument 404 /404.php
RewriteEngine On

# Force HTTPS (skipped for local testing)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Generated files: sitemap, robots and llms are built by PHP from includes/pages.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^llms\.txt$ llms.php [L]
# Only the .xml/.txt addresses are public, not the generator scripts
RewriteCond %{THE_REQUEST} \s/(sitemap|robots|llms)(\.php)?[\s?]
RewriteRule ^ - [R=404,L]

# Old hall page address -> new one (permanent)
RewriteRule ^halls(\.php)?/?$ /venutai-chavan-multipurpose-hall [R=301,L]
RewriteRule ^en/halls(\.php)?/?$ /en/venutai-chavan-multipurpose-hall [R=301,L]

# Block direct access to includes (before any rewrite)
RewriteRule ^includes/ - [F,L]

# /index.php and /en/index.php -> folder URL
RewriteCond %{THE_REQUEST} \s/((?:[^/\s]+/)*)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /page.php to /page (GET only, so form posts keep working)
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s/([^.?\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Remove trailing slash from page URLs (/about-samiti/ -> /about-samiti)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve /page from page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
